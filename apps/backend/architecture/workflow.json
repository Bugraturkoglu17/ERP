{
  "domain": "workflow",
  "description": "Idempotent DAG execution engine for automation rules and workflows.",
  "entities": [
    "WorkflowDefinition",
    "WorkflowVersion",
    "WorkflowRun",
    "WorkflowRunNode",
    "WorkflowTrigger",
    "WorkflowAction",
    "WorkflowTemplate"
  ],
  "routes": [
    "app.api.v1.routes.workflow"
  ],
  "roles": [
    "admin",
    "platform_admin"
  ],
  "tenant_helper": "get_current_tenant_id",
  "notifications": [
    "workflow_failed",
    "workflow_stalled"
  ],
  "dependencies": [
    "approvals",
    "notifications",
    "whatsapp"
  ],
  "permissions": [
    "workflow:read",
    "workflow:configure",
    "workflow:execute"
  ],
  "events": [
    "workflow_run_started",
    "workflow_run_completed",
    "workflow_run_failed"
  ],
  "tasks": [
    "app.core.workers.tasks.execute_workflow_run_task"
  ],
  "storage_prefixes": [],
  "indexes": [],
  "public_endpoints": [],
  "security_policy": {
    "tenant_isolation": "strict",
    "rbac_enforced": true,
    "entitlement_gates": [
      "require_module('workflow')",
      "require_feature('workflow.studio')"
    ]
  }
}
