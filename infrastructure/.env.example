# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=sismik_erp
POSTGRES_USER=sismik_admin
POSTGRES_PASSWORD=<değiştirin_üretimde>

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=<değiştirin>

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@sismikmekanik.com.tr
PGADMIN_PASSWORD=<değiştirin>

# ── JWT Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY=<jwt_icin_min_32_karakter_anahtari_olusturun>
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Oracle Cloud (OCI / S3-compatible Object Storage) ─────────────────────────
OCI_BUCKET_NAME=sismik-documents
OCI_NAMESPACE=your-tenancy-namespace
OCI_REGION=eu-frankfurt-1
OCI_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
AWS_ACCESS_KEY_ID=<s3_access_key_id>
AWS_SECRET_ACCESS_KEY=<s3_secret_access_key>

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_WORKERS=4
CELERY_WORKER_POOL=prefork

# ── Runtime ───────────────────────────────────────────────────────────────────
ENV=development

# ── DB / Cache URLs (opsiyonel override) ─────────────────────────────────────
# DATABASE_URL=postgresql+psycopg2://sismik_admin:<db_sifre>@db:5432/sismik_erp
# REDIS_URL=redis://:<redis_sifre>@redis:6379/0

# ── Bootstrap / Migration ─────────────────────────────────────────────────────
AUTO_MIGRATE=true
AUTO_MIGRATE_WAIT_SECONDS=90
AUTO_BOOTSTRAP_PLATFORM_ADMIN=false

# ── Platform Admin Bootstrap (opsiyonel) ──────────────────────────────────────
PLATFORM_ADMIN_EMAIL=platform.admin@golabstek.com
PLATFORM_ADMIN_PASSWORD=<min_10_karakter>
PLATFORM_ADMIN_FULL_NAME=Platform Admin
# Geriye dönük alias'lar
# ADMIN_EMAIL=platform.admin@golabstek.com
# ADMIN_PASSWORD=<min_10_karakter>

# ── Email / Resend ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=<resend_api_key>
EMAIL_FROM_DEFAULT=info@golabstek.com
EMAIL_FROM_NAME_DEFAULT=GOLABS ERP
EMAIL_REPLY_TO_DEFAULT=info@golabstek.com

# Bildirim davranışı
EMAIL_ASYNC_ENABLED=true
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY_SECONDS=60

# ── WhatsApp Cloud API ──────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=<whatsapp_access_token>
WHATSAPP_PHONE_NUMBER_ID=<whatsapp_phone_number_id>
WHATSAPP_BUSINESS_ACCOUNT_ID=<whatsapp_business_account_id>
WHATSAPP_API_VERSION=v22.0
WHATSAPP_VERIFY_TOKEN=<whatsapp_verify_token>
